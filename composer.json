{
  "name": "afbora/kirby-template-hooks",
  "description": "Enable page and file template hooks and user role hooks for Kirby",
  "keywords": [
    "kirby",
    "kirby-plugin",
    "kirby5",
    "kirby6"
  ],
  "type": "kirby-plugin",
  "license": "MIT",
  "homepage": "https://github.com/afbora/kirby-template-hooks",
  "support": {
    "email": "ahmet@getkirby.com"
  },
  "authors": [
    {
      "name": "Ahmet Bora",
      "email": "ahmet@getkirby.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "getkirby/cms": "^5.0 || ^6.0",
    "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "installer-name": "kirby-template-hooks",
    "kirby": {
      "compatible": "^5.0 || ^6.0"
    },
    "kirby-cms-path": false
  }
}
