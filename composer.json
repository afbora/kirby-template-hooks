{
  "name": "afbora/kirby-template-hooks",
  "description": "Enable page and file template hooks for Kirby",
  "keywords": [
    "kirby",
    "kirby-plugin",
    "kirby5",
    "kirby6"
  ],
  "version": "1.2.2",
  "type": "kirby-plugin",
  "license": "MIT",
  "homepage": "https://github.com/afbora/kirby-template-hooks",
  "support": {
    "email": "ahmet@getkirby.com"
  },
  "authors": [
    {
      "name": "Ahmet Bora",
      "email": "ahmet@getkirby.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "installer-name": "kirby-template-hooks",
    "kirby": {
      "compatible": "^5.0 || ^6.0"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
